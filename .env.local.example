# Supabase (self-hosted via deploy/docker-compose.yml, or Supabase Cloud)
# SUPABASE_URL is the Kong API gateway URL (port 8000 for local Docker)
VITE_SUPABASE_URL=http://localhost:8000
# Anon key from deploy/.env (or Supabase Cloud project settings)
VITE_SUPABASE_ANON_KEY=

# App branding (choose one)
VITE_TITLE="Iron Fellowship"
VITE_FAVICON_PATH=/theme/eidolon.svg
VITE_OPENGRAPH_PATH=/assets/ironsworn/opengraph-default.png

# --- OR for Crew Link ---
# VITE_TITLE="Starforged Crew Link"
# VITE_FAVICON_PATH=/theme/eidolon.svg
# VITE_OPENGRAPH_PATH=/assets/starforged/opengraph-default.png

# Optional: PostHog analytics + feature flags
# VITE_POSTHOG_KEY=
# VITE_POSTHOG_HOST=
