############################################################
# Iron Fellowship / Crew Link — Supabase Self-Hosted .env
# Copy this file to .env and fill in all values before
# running ./scripts/setup.sh
#
# WARNING: Some values CANNOT be changed after first run
# without a full database reset. These are marked IMMUTABLE.
############################################################

# ---------------------------------------------------------------------------
# DATABASE
# ---------------------------------------------------------------------------

# PostgreSQL superuser password
# Generate: openssl rand -base64 32
# IMMUTABLE: changing this after first start requires pg_hba.conf edits
POSTGRES_PASSWORD=

# ---------------------------------------------------------------------------
# JWT (MUST be configured before generating ANON_KEY / SERVICE_ROLE_KEY)
# ---------------------------------------------------------------------------

# JWT signing secret — must be at least 32 characters
# Generate: openssl rand -base64 32
# IMMUTABLE: all existing JWTs become invalid if changed
JWT_SECRET=

# Expiry time for JWT tokens (in seconds). Default: 3600 (1 hour)
JWT_EXPIRY=3600

# Anon key — a JWT signed with JWT_SECRET and role "anon"
# Generate with this Node.js one-liner (replace YOUR_JWT_SECRET):
#
#   node -e "
#   const jwt = require('jsonwebtoken');
#   const payload = { role: 'anon', iss: 'supabase', iat: Math.floor(Date.now()/1000), exp: Math.floor(Date.now()/1000) + (10 * 365 * 24 * 60 * 60) };
#   console.log(jwt.sign(payload, 'YOUR_JWT_SECRET'));
#   "
#
# Or use: https://supabase.com/docs/guides/self-hosting#api-keys
ANON_KEY=

# Service role key — a JWT signed with JWT_SECRET and role "service_role"
# Generate with same one-liner but change role to "service_role"
# KEEP THIS SECRET — it bypasses RLS
SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# SUPABASE STUDIO (Dashboard)
# ---------------------------------------------------------------------------

# Studio login credentials
DASHBOARD_USERNAME=supabase
DASHBOARD_PASSWORD=

# ---------------------------------------------------------------------------
# URLS
# ---------------------------------------------------------------------------

# The public URL of the application (used in auth redirect URLs)
SITE_URL=http://localhost:3000

# The public URL of the Supabase API (Kong gateway)
# In production this is your domain or IP with port 8000
API_EXTERNAL_URL=http://localhost:8000

# ---------------------------------------------------------------------------
# AUTH (GoTrue)
# ---------------------------------------------------------------------------

# Google OAuth — register at https://console.cloud.google.com/
GOTRUE_EXTERNAL_GOOGLE_ENABLED=true
GOTRUE_EXTERNAL_GOOGLE_CLIENT_ID=
GOTRUE_EXTERNAL_GOOGLE_SECRET=
GOTRUE_EXTERNAL_GOOGLE_REDIRECT_URI=${API_EXTERNAL_URL}/auth/v1/callback

# Email OTP (magic link) settings
# Set GOTRUE_MAILER_AUTOCONFIRM=true to skip email verification in development
GOTRUE_MAILER_AUTOCONFIRM=false
GOTRUE_MAILER_OTP_EXP=3600

# ---------------------------------------------------------------------------
# SMTP (required for email magic links)
# ---------------------------------------------------------------------------

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_ADMIN_EMAIL=noreply@example.com
SMTP_SENDER_NAME=Iron Fellowship

# ---------------------------------------------------------------------------
# AI PROVIDERS (used by Edge Functions)
# ---------------------------------------------------------------------------

ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ---------------------------------------------------------------------------
# INTERNAL PORTS (change only if you have conflicts)
# ---------------------------------------------------------------------------

KONG_HTTP_PORT=8000
KONG_HTTPS_PORT=8443
STUDIO_PORT=3000
